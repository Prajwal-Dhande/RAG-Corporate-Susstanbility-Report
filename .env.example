# =============================================================================
# Sustainability MMKG-RAG Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# --- API Keys ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Database ---
# For development: sqlite:///./data/app.db
# For production: postgresql+asyncpg://user:pass@localhost:5432/sustainability_rag
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Neo4j (optional for MVP, uses NetworkX fallback) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- Redis (optional for MVP, uses asyncio fallback) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (optional for MVP, uses local filesystem) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sustainability-reports
MINIO_USE_SSL=false

# --- Storage ---
# local or minio
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

# --- Graph Backend ---
# networkx or neo4j
GRAPH_BACKEND=networkx

# --- Model Configuration ---
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o-mini
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=4096

EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Processing ---
PDF_MAX_SIZE_MB=200
PAGE_RENDER_DPI=200
MAX_EXTRACTION_RETRIES=3
BATCH_SIZE=5

# --- Retrieval Weights ---
RETRIEVAL_ALPHA=0.35
RETRIEVAL_BETA=0.25
RETRIEVAL_GAMMA=0.25
RETRIEVAL_DELTA=0.10
RETRIEVAL_EPSILON=0.05

# --- Confidence Weights ---
CONFIDENCE_EXTRACTION=0.25
CONFIDENCE_GROUNDING=0.25
CONFIDENCE_AGREEMENT=0.25
CONFIDENCE_RETRIEVAL=0.25

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
